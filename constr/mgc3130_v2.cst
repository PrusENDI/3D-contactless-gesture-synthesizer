// V2 board pin contract copied from the V1 board allocation.
// The V2 top keeps the same physical sensor, USB-UART and PCM5102A pins.
IO_LOC  "clk_50m" E2;
IO_LOC  "uart_tx" C3;
IO_LOC  "uart_rx" B3;
IO_LOC  "pcm5102a_bck" G1;
IO_LOC  "pcm5102a_lrck" L3;
IO_LOC  "pcm5102a_din" C2;
IO_LOC  "mgc_sda" K4;
IO_LOC  "mgc_scl" K1;
IO_LOC  "mgc_ts" L1;
IO_LOC  "mgc_mclr" L2;

IO_PORT "clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "pcm5102a_bck" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "pcm5102a_lrck" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "pcm5102a_din" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "mgc_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "mgc_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "mgc_ts" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "mgc_mclr" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 0.96" SSD1306, 7-pin SPI, on J3 pins 27..31 and 39 (see the OLED spec 4.1).
IO_LOC  "oled_sck"   J7;
IO_LOC  "oled_mosi"  K7;
IO_LOC  "oled_res_n" L8;
IO_LOC  "oled_dc"    L7;
IO_LOC  "oled_cs_n"  K10;
IO_LOC  "oled_blk"   J10;

IO_PORT "oled_sck" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "oled_mosi" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "oled_res_n" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "oled_dc" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "oled_cs_n" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "oled_blk" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
