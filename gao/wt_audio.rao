<?xml version="1" encoding="UTF-8"?>
<GAO_CONFIG>
    <Version>3.0</Version>
    <Mode>Standard</Mode>
    <!--
      Audio-domain morph probe (objective substitute for listening).

      sample_clock  u_v2/pcm5102a_lrck    48 kHz I2S frame clock
      window        2048 / 48 kHz = 42.7 ms ~= 18.8 cycles of A4 (440 Hz)
      trigger       i2s_sample_valid = 1 (audio flowing); WT_PLAY is continuous

      What it proves: capture at position near frame A must be a near-sine
      spectrum; near the B/C boundary it must carry many harmonics.  A closed
      loop in position is NOT visible here (seconds vs 42.7 ms); read
      u_v2/wt_pos[25:8] as a constant label for the capture's position.
    -->
    <AoCore index="0" sample_clock="u_v2/pcm5102a_lrck" trig_type="0"
             storage_depth="2048" window_num="1" capture_amount="2048"
             implementation="0" trigger_pos="64" module_name="v2_board_top"
             force_trigger_by_falling_edge="false" capture_init_data_enabled="false">
        <SignalList>
            <Signal capture_enable="true">u_v2/i2s_sample_valid</Signal>
            <Bus capture_enable="true" name="u_v2/i2s_sample[15:0]">
                <Signal>u_v2/i2s_sample[15]</Signal>
                <Signal>u_v2/i2s_sample[14]</Signal>
                <Signal>u_v2/i2s_sample[13]</Signal>
                <Signal>u_v2/i2s_sample[12]</Signal>
                <Signal>u_v2/i2s_sample[11]</Signal>
                <Signal>u_v2/i2s_sample[10]</Signal>
                <Signal>u_v2/i2s_sample[9]</Signal>
                <Signal>u_v2/i2s_sample[8]</Signal>
                <Signal>u_v2/i2s_sample[7]</Signal>
                <Signal>u_v2/i2s_sample[6]</Signal>
                <Signal>u_v2/i2s_sample[5]</Signal>
                <Signal>u_v2/i2s_sample[4]</Signal>
                <Signal>u_v2/i2s_sample[3]</Signal>
                <Signal>u_v2/i2s_sample[2]</Signal>
                <Signal>u_v2/i2s_sample[1]</Signal>
                <Signal>u_v2/i2s_sample[0]</Signal>
            </Bus>
            <Bus capture_enable="true" name="u_v2/wt_play_index[9:0]">
                <Signal>u_v2/wt_play_index[9]</Signal>
                <Signal>u_v2/wt_play_index[8]</Signal>
                <Signal>u_v2/wt_play_index[7]</Signal>
                <Signal>u_v2/wt_play_index[6]</Signal>
                <Signal>u_v2/wt_play_index[5]</Signal>
                <Signal>u_v2/wt_play_index[4]</Signal>
                <Signal>u_v2/wt_play_index[3]</Signal>
                <Signal>u_v2/wt_play_index[2]</Signal>
                <Signal>u_v2/wt_play_index[1]</Signal>
                <Signal>u_v2/wt_play_index[0]</Signal>
            </Bus>
            <Bus capture_enable="true" name="u_v2/wt_pos[25:8]">
                <Signal>u_v2/wt_pos[25]</Signal>
                <Signal>u_v2/wt_pos[24]</Signal>
                <Signal>u_v2/wt_pos[23]</Signal>
                <Signal>u_v2/wt_pos[22]</Signal>
                <Signal>u_v2/wt_pos[21]</Signal>
                <Signal>u_v2/wt_pos[20]</Signal>
                <Signal>u_v2/wt_pos[19]</Signal>
                <Signal>u_v2/wt_pos[18]</Signal>
                <Signal>u_v2/wt_pos[17]</Signal>
                <Signal>u_v2/wt_pos[16]</Signal>
                <Signal>u_v2/wt_pos[15]</Signal>
                <Signal>u_v2/wt_pos[14]</Signal>
                <Signal>u_v2/wt_pos[13]</Signal>
                <Signal>u_v2/wt_pos[12]</Signal>
                <Signal>u_v2/wt_pos[11]</Signal>
                <Signal>u_v2/wt_pos[10]</Signal>
                <Signal>u_v2/wt_pos[9]</Signal>
                <Signal>u_v2/wt_pos[8]</Signal>
            </Bus>
        </SignalList>
        <Triggers>
            <Trigger index="0">
                <SignalList>
                    <Signal>u_v2/i2s_sample_valid</Signal>
                </SignalList>
            </Trigger>
            <Trigger index="1"/>
            <Trigger index="2"/>
            <Trigger index="3"/>
            <Trigger index="4"/>
            <Trigger index="5"/>
            <Trigger index="6"/>
            <Trigger index="7"/>
            <Trigger index="8"/>
            <Trigger index="9"/>
            <Trigger index="10"/>
            <Trigger index="11"/>
            <Trigger index="12"/>
            <Trigger index="13"/>
            <Trigger index="14"/>
            <Trigger index="15"/>
        </Triggers>
        <MatchUnits>
            <MatchUnit index="0" enabled="1" match_type="0" counter_enable="0"
                       counter_width="2" counter="2" countinuous="0" func="0"
                       value0="1" value1="0" trigger="0"/>
            <MatchUnit index="1" enabled="0" match_type="0" counter_enable="0"
                       counter_width="2" counter="2" countinuous="0" func="0"
                       value0="" value1=""/>
        </MatchUnits>
        <Expressions type="Static">
            <Expression>M0</Expression>
        </Expressions>
    </AoCore>
</GAO_CONFIG>
